pipeline {
    agent any

    triggers {
        githubPush()
    }

    environment {
        PATH = "/Users/user/.docker/bin:/usr/local/bin:/usr/bin:/bin:${env.PATH}"

        IMAGE_NAME = 'distributed-web-app'

        NEXUS_PYPI_URL = 'http://localhost:8081/repository/pypi-group/simple/'

        AWS_DEFAULT_REGION = 'us-east-1'

        GITOPS_REPO = 'https://github.com/HaikGr/distributed-web-app-deployment.git'
    }

    stages {

        stage('Environment') {
            steps {
                sh '''
                    echo "===== ENVIRONMENT ====="
                    python3 --version
                    docker --version
                    git --version
                    pwd
                    ls -la

                    echo "===== BUILD ====="
                    echo "BUILD_NUMBER=${BUILD_NUMBER}"
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('web-app') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'nexus-key',
                            usernameVariable: 'NEXUS_USER',
                            passwordVariable: 'NEXUS_PASSWORD'
                        )
                    ]) {
                        sh '''
                            set -e

                            echo "===== CREATE VIRTUAL ENVIRONMENT ====="

                            rm -rf .venv
                            python3 -m venv .venv

                            .venv/bin/python -m pip install --upgrade pip

                            echo "===== INSTALL REQUIREMENTS FROM NEXUS ====="

                            .venv/bin/pip install \
                                --index-url "http://${NEXUS_USER}:${NEXUS_PASSWORD}@localhost:8081/repository/pypi-group/simple/" \
                                -r requirements.txt

                            echo "===== INSTALLED PACKAGES ====="

                            .venv/bin/pip list
                        '''
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('web-app') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'nexus-key',
                            usernameVariable: 'NEXUS_USER',
                            passwordVariable: 'NEXUS_PASSWORD'
                        )
                    ]) {
                        sh '''
                            set -e

                            echo "===== DOCKER BUILD ====="

                            docker build \
                                --build-arg NEXUS_URL="http://${NEXUS_USER}:${NEXUS_PASSWORD}@host.docker.internal:8081/repository/pypi-group/simple/" \
                                -t ${IMAGE_NAME}:${BUILD_NUMBER} \
                                -t ${IMAGE_NAME}:latest \
                                .
                        '''
                    }
                }
            }
        }

        stage('Docker Images') {
            steps {
                sh '''
                    echo "===== DOCKER IMAGES ====="

                    docker images ${IMAGE_NAME}
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-key',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "===== LOGIN TO NEXUS DOCKER REGISTRY ====="

                        echo "${NEXUS_PASSWORD}" | docker login localhost:8082 \
                            --username "${NEXUS_USER}" \
                            --password-stdin

                        echo "===== TAG IMAGE ====="

                        docker tag \
                            ${IMAGE_NAME}:${BUILD_NUMBER} \
                            localhost:8082/${IMAGE_NAME}:${BUILD_NUMBER}

                        echo "===== PUSH IMAGE ====="

                        docker push \
                            localhost:8082/${IMAGE_NAME}:${BUILD_NUMBER}

                        echo "===== IMAGE PUSHED ====="

                        echo "localhost:8082/${IMAGE_NAME}:${BUILD_NUMBER}"
                    '''
                }
            }
        }

        stage('Update GitOps Repository') {
            steps {
                dir('gitops') {

                    deleteDir()

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'github-gitops',
                            usernameVariable: 'GITHUB_USER',
                            passwordVariable: 'GITHUB_TOKEN'
                        )
                    ]) {
                        sh '''
                            set -e

                            echo "===== CLONE GITOPS REPOSITORY ====="

                            git clone \
                                "https://${GITHUB_USER}:${GITHUB_TOKEN}@github.com/HaikGr/distributed-web-app-deployment.git" \
                                .

                            git config user.name "Jenkins"
                            git config user.email "jenkins@localhost"

                            echo "===== CURRENT VALUES ====="

                            cat helm/distributed-web-app/values.yaml

                            echo "===== UPDATE IMAGE TAG ====="

                            sed -i.bak \
                                "s/^  tag: .*/  tag: \\"${BUILD_NUMBER}\\"/" \
                                helm/distributed-web-app/values.yaml

                            rm -f helm/distributed-web-app/values.yaml.bak

                            echo "===== UPDATED VALUES ====="

                            cat helm/distributed-web-app/values.yaml

                            echo "===== GIT DIFF ====="

                            git diff

                            git add helm/distributed-web-app/values.yaml

                            if git diff --cached --quiet; then
                                echo "No changes to commit."
                                exit 0
                            fi

                            git commit \
                                -m "chore: update image tag to ${BUILD_NUMBER}"

                            echo "===== PUSH GITOPS CHANGE ====="

                            git push origin HEAD:main

                            echo "===== GITOPS UPDATE COMPLETE ====="
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Web application Docker image built, pushed to Nexus, and GitOps repository updated successfully.'
        }

        failure {
            echo 'Web application pipeline failed.'
        }
    }
}